         target_ids = self.draft_to_target_ids[draft_ids]  # new tensor; no clone needed
         missing = target_ids == -1
-        if missing.any():
-            target_ids[missing] = self.target_unk_token_id
+        target_ids = torch.where(missing, self.target_unk_token_id, target_ids)
         return target_ids.to(draft_ids.dtype)
 
     def constrain_draft_logits(self, logits):
         # masked_fill returns a new tensor; no clone needed
         return logits.masked_fill(~self.intersection_mask_draft, float("-inf"))
+
+    def constrain_draft_logits_(self, logits):
+        """Mask only non-intersection columns without copying the full logits."""
+        return logits.index_fill_(-1, self.invalid_draft_token_ids, float("-inf"))
diff --git a/tests/v1/spec_decode/test_spec_rhythm.py b/tests/v1/spec_decode/test_spec_rhythm.py
